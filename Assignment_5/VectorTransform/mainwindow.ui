            <widget class="QComboBox" name="comboFillAlgorithm">
             <item><property name="text"><string>✨ Scanline Polygon Fill (AET)</string></property></item>
             <item><property name="text"><string>🎨 8-Way Boundary Fill (BFS Wavefront)</string></property></item>
             <item><property name="text"><string>🎨 8-Way Boundary Fill (DFS Stack)</string></property></item>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="fillActionLayout">
             <item>
              <widget class="QPushButton" name="btnExecuteFill">
               <property name="text"><string>▶ Execute Fill</string></property>
               <property name="styleSheet"><string>background-color: #1f6feb; color: #ffffff; font-weight: bold; padding: 6px;</string></property>
              </widget>
             </item>
             <item><widget class="QPushButton" name="btnClearFill"><property name="text"><string>Clear Fill</string></property></widget></item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- 4. Shape Tools & Presets -->
        <item>
         <widget class="QGroupBox" name="groupShapes">
          <property name="title">
           <string>4. Shape Tools &amp; Presets</string>
          </property>
          <layout class="QVBoxLayout" name="shapesVLayout">
           <property name="spacing">
            <number>6</number>
           </property>
           <item>
            <layout class="QGridLayout" name="shapeButtonsGrid">
             <item row="0" column="0"><widget class="QPushButton" name="btnDrawPolygon"><property name="text"><string>✏ Draw Poly</string></property></widget></item>
             <item row="0" column="1"><widget class="QPushButton" name="btnDrawCircle"><property name="text"><string>⚪ Draw Circle</string></property></widget></item>
             <item row="1" column="0"><widget class="QPushButton" name="btnClosePolygon"><property name="text"><string>✔ Close Poly</string></property><property name="styleSheet"><string>background-color: #238636; color: #ffffff;</string></property></widget></item>
             <item row="1" column="1"><widget class="QPushButton" name="btnUndoShape"><property name="text"><string>↶ Undo Shape</string></property></widget></item>
            </layout>
           </item>
           <item><widget class="QLabel" name="lblPresetsHeader"><property name="text"><string>Load Geometric Presets:</string></property></widget></item>
           <item>
            <layout class="QGridLayout" name="presetsGrid">
             <item row="0" column="0"><widget class="QPushButton" name="btnPresetTriangle"><property name="text"><string>Triangle (3-gon)</string></property></widget></item>
             <item row="0" column="1"><widget class="QPushButton" name="btnPresetConvex"><property name="text"><string>Convex (5-gon)</string></property></widget></item>
             <item row="1" column="0"><widget class="QPushButton" name="btnPresetHouse"><property name="text"><string>House / Pentagon</string></property></widget></item>
             <item row="1" column="1"><widget class="QPushButton" name="btnPresetStar"><property name="text"><string>5-Point Star</string></property></widget></item>
             <item row="2" column="0"><widget class="QPushButton" name="btnPresetConcave"><property name="text"><string>Concave Arrow</string></property></widget></item>
             <item row="2" column="1"><widget class="QPushButton" name="btnPresetNested"><property name="text"><string>🍩 Nested Donut</string></property></widget></item>
             <item row="3" column="0" colspan="2"><widget class="QPushButton" name="btnPresetMultiScene"><property name="text"><string>🎭 Multi-Scene (2 Polys + Circle)</string></property><property name="styleSheet"><string>background-color: #21262d; border: 1px solid #2ea043; color: #2ea043; font-weight: bold;</string></property></widget></item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

       </layout>
      </widget>
     </widget>
    </item>

    <!-- CENTER & RIGHT: Canvas + Matrix Inspector -->
    <item>
     <layout class="QVBoxLayout" name="canvasAndMatrixVLayout">
      <property name="spacing">
       <number>6</number>
      </property>

      <!-- Canvas Widget -->
      <item>
       <widget class="Canvas" name="canvasWidget" native="true">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
          <horstretch>0</horstretch>
          <verstretch>1</verstretch>
         </sizepolicy>
        </property>
       </widget>
      </item>

      <!-- Bottom Dashboard: Matrix Inspector & History -->
      <item>
       <layout class="QHBoxLayout" name="bottomDashboardLayout">
        <property name="spacing">
         <number>8</number>
        </property>

        <!-- 3x3 Homogeneous Matrix Box -->
        <item>
         <widget class="QGroupBox" name="groupMatrixViewer">
          <property name="title">
           <string>📐 Active 3x3 Homogeneous Transformation Matrix [M]</string>
          </property>
          <layout class="QVBoxLayout" name="matrixBoxVLayout">
           <property name="spacing">
            <number>4</number>
           </property>
           <item>
            <widget class="QLabel" name="lblMatrixFormula">
             <property name="text">
              <string>M_composite = I (Identity)</string>
             </property>
             <property name="styleSheet">
              <string>color: #e3b341; font-weight: bold; font-family: monospace; font-size: 12px;</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QTextEdit" name="txtMatrixDisplay">
             <property name="readOnly">
              <bool>true</bool>
             </property>
             <property name="maximumHeight">
              <number>110</number>
             </property>
             <property name="styleSheet">
              <string>background-color: #0d1117; border: 1px solid #30363d; font-family: monospace; font-size: 12px;</string>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="matrixActionsLayout">
             <item><widget class="QLabel" name="lblMatrixDet"><property name="text"><string>Det(M): 1.000</string></property><property name="styleSheet"><string>color: #8b949e; font-size: 11px;</string></property></widget></item>
             <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
             <item><widget class="QPushButton" name="btnUndoTransform"><property name="text"><string>↶ Undo Step</string></property></widget></item>
             <item><widget class="QPushButton" name="btnResetTransform"><property name="text"><string>🔄 Reset Matrix (I)</string></property><property name="styleSheet"><string>color: #ff7b72;</string></property></widget></item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- Transformation History Log -->
        <item>
         <widget class="QGroupBox" name="groupHistory">
          <property name="title">
           <string>📋 Transformation Pipeline History</string>
          </property>
          <layout class="QVBoxLayout" name="historyVLayout">
           <property name="spacing">
            <number>4</number>
           </property>
           <item>
            <widget class="QTableWidget" name="tableHistory">
             <property name="maximumHeight">
              <number>110</number>
             </property>
             <property name="editTriggers">
              <set>QAbstractItemView::NoEditTriggers</set>
             </property>
             <property name="alternatingRowColors">
              <bool>true</bool>
             </property>
             <column>
              <property name="text"><string>Step #</string></property>
             </column>
             <column>
              <property name="text"><string>Transformation</string></property>
             </column>
             <column>
              <property name="text"><string>Parameters / Formula</string></property>
             </column>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <!-- View Controls & Overlays -->
        <item>
         <widget class="QGroupBox" name="groupView">
          <property name="title">
           <string>👁 Display &amp; Overlays</string>
          </property>
          <layout class="QGridLayout" name="viewGridLayout">
           <property name="spacing">
            <number>4</number>
           </property>
           <item row="0" column="0"><widget class="QCheckBox" name="chkShowGhost"><property name="text"><string>Show Ghost (Pre-Transform)</string></property><property name="checked"><bool>true</bool></property></widget></item>
           <item row="0" column="1"><widget class="QCheckBox" name="chkShowPivot"><property name="text"><string>Show Pivot Point</string></property><property name="checked"><bool>true</bool></property></widget></item>
           <item row="1" column="0"><widget class="QCheckBox" name="chkShowReflectLine"><property name="text"><string>Show Reflection Line</string></property><property name="checked"><bool>true</bool></property></widget></item>
           <item row="1" column="1"><widget class="QCheckBox" name="chkShowLabels"><property name="text"><string>Show Vertex Labels</string></property><property name="checked"><bool>true</bool></property></widget></item>
           <item row="2" column="0"><widget class="QCheckBox" name="chkShowGrid"><property name="text"><string>Show Grid</string></property><property name="checked"><bool>true</bool></property></widget></item>
           <item row="2" column="1"><widget class="QCheckBox" name="chkShowAxes"><property name="text"><string>Show Axes</string></property><property name="checked"><bool>true</bool></property></widget></item>
           <item row="3" column="0"><widget class="QLabel" name="lblGridSize"><property name="text"><string>Grid Cell Size:</string></property></widget></item>
           <item row="3" column="1"><widget class="QSpinBox" name="spinGridSize"><property name="minimum"><number>6</number></property><property name="maximum"><number>50</number></property><property name="value"><number>14</number></property></widget></item>
           <item row="4" column="0" colspan="2"><widget class="QPushButton" name="btnClearAll"><property name="text"><string>✖ Clear All (Shapes &amp; Fills)</string></property></widget></item>
          </layout>
         </widget>
        </item>

       </layout>
      </item>

     </layout>
    </item>
   </layout>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
 </widget>
 <customwidgets>
  <customwidget>
   <class>Canvas</class>
   <extends>QWidget</extends>
   <header>canvas.h</header>
   <container>1</container>
  </customwidget>
 </customwidgets>
